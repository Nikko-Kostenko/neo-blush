<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkMenu" id="menu">
    <child>
      <object class="GtkMenuItem" id="header">
        <property name="label">WI-FI</property>
        <property name="sensitive">false</property>
      </object>
    </child>
    <child>
      <object class="GtkMenuItem" id="settings">
        <property name="label">Network settings…</property>
      </object>
    </child>
    <child><object class="GtkSeparatorMenuItem" id="separator2"/></child>
    <child>
      <object class="GtkMenuItem" id="enable">
        <property name="label">Turn Wi-Fi on</property>
      </object>
    </child>
    <child>
      <object class="GtkMenuItem" id="disable">
        <property name="label">Turn Wi-Fi off</property>
      </object>
    </child>
    <child>
      <object class="GtkMenuItem" id="rescan">
        <property name="label">Scan for networks</property>
      </object>
    </child>
  </object>
</interface>
