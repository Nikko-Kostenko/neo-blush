{
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "overlay",
  "control-center-margin-top": 44,
  "control-center-margin-right": 12,
  "control-center-margin-bottom": 12,
  "control-center-width": 372,
  "control-center-height": -1,
  "fit-to-screen": false,
  "notification-window-width": 372,
  "ignore-gtk-theme": true,
  "cssPriority": "user",
  "relative-timestamps": true,
  "text-empty": "You're all caught up",
  "transition-time": 160,
  "timeout": 8,
  "timeout-low": 5,
  "timeout-critical": 0,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "hide-on-action": true,
  "widgets": ["title", "dnd", "notifications"],
  "widget-config": {
    "title": {"text": "Notification Center", "clear-all-button": true, "button-text": "Clear All"},
    "dnd": {"text": "Do Not Disturb"},
    "notifications": {"vexpand": false}
  }
}
